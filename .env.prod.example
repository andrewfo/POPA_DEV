# Production secrets/config for docker-compose.prod.yml.
# Copy to .env.prod (gitignored) and fill in real values:
#
#   cp .env.prod.example .env.prod
#
# Injected via `env_file` into each container's environment.

# --- Database ---
# CHANGE the password. POSTGRES_HOST is set to the `db` service by compose; do
# not set it here.
POSTGRES_USER=popa
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=popa_wharf
# Optional: a full SQLAlchemy URL overrides the POSTGRES_* assembly. Leave unset
# to use the values above against the in-stack `db` service.
# DATABASE_URL=postgresql+psycopg://popa:CHANGE_ME@db:5432/popa_wharf

# --- Operator auth (HTTP Basic, whole app) ---
# REQUIRED to enable auth. If either is blank the app runs OPEN (no login) — fine
# for a private network, but set both for any reachable deployment. Runs behind
# TLS only (see the compose header).
OPERATOR_USER=operator
OPERATOR_PASSWORD=CHANGE_ME_operator_password

# --- AIS ingestion ---
# Free key at https://aisstream.io. The `ais` service needs this to ingest.
AISSTREAM_API_KEY=

# Bounding box around the POPA public wharf (decimal degrees). Defaults match
# app/config.py; override only to retune the subscription footprint.
# AIS_BBOX_SW_LAT=29.823
# AIS_BBOX_SW_LON=-93.9586
# AIS_BBOX_NE_LAT=29.866
# AIS_BBOX_NE_LON=-93.930

# --- Workers ---
# API worker processes (gunicorn). Tune to the host's CPU.
WEB_CONCURRENCY=4
# Seconds between occupancy-derivation passes.
OCC_EVERY=60

# Berth requests are entered manually by an operator (phone / email / walk-in);
# there is no automated online-form feed to configure.
