# Copy to .env and fill in. docker-compose and the app both read these.

# --- Database ---
# Local dev default matches docker-compose.yml below.
POSTGRES_USER=popa
POSTGRES_PASSWORD=popa
POSTGRES_DB=popa_wharf
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* vars above.
# DATABASE_URL=postgresql+psycopg://popa:popa@localhost:5432/popa_wharf

# --- AIS ingestion ---
# Get a free key at https://aisstream.io
AISSTREAM_API_KEY=

# Bounding box around the POPA public wharf on the Sabine-Neches waterway.
# Two corners: SW (lat,lon) and NE (lat,lon). Decimal degrees.
AIS_BBOX_SW_LAT=29.850
AIS_BBOX_SW_LON=-93.946
AIS_BBOX_NE_LAT=29.866
AIS_BBOX_NE_LON=-93.930

# --- Live berth-request intake: BerthRequests SharePoint list via MS Graph ---
# From an Azure AD app registration in the portpa.com tenant with Graph
# Sites.Selected (or Sites.Read.All), granted by port IT. Leave blank until
# provisioned; `python -m app.intake.run_sharepoint` errors clearly if unset.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Site + list identity (defaults match the live form URL).
SHAREPOINT_SITE_HOSTNAME=theportofportarthur.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/BerthRequest
SHAREPOINT_LIST_NAME=BerthRequests
