# Copy to .env and fill in:  cp .env.example .env
# Both the app (app/config.py reads .env) and docker-compose read these.
# .env is gitignored — keep real secrets there, never in this template.

# --- Database ---
# Dev defaults match docker-compose.yml. For the production stack
# (docker-compose.prod.yml) CHANGE the password to something strong; compose
# overrides POSTGRES_HOST to the in-stack `db` service, so leave it as localhost
# here (it's the bare-metal dev default).
POSTGRES_USER=popa
POSTGRES_PASSWORD=popa
POSTGRES_DB=popa_wharf
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* vars above.
# DATABASE_URL=postgresql+psycopg://popa:popa@localhost:5432/popa_wharf

# --- Operator auth (HTTP Basic, whole app) ---
# Leave BOTH blank for local dev: auth is disabled and the app runs open. Set
# BOTH to gate the whole app (map + reads + writes) behind one login — REQUIRED
# for any reachable deployment. Basic auth only base64-encodes credentials, so
# it must run behind TLS terminated upstream (see DEPLOY.md).
OPERATOR_USER=
OPERATOR_PASSWORD=

# --- AIS ingestion ---
# Get a free key at https://aisstream.io. Needed to ingest live positions.
AISSTREAM_API_KEY=

# Bounding box around the POPA public wharf on the Sabine-Neches waterway.
# Two corners: SW (lat,lon) and NE (lat,lon). Decimal degrees. Defaults match
# app/config.py; override only to retune the subscription footprint.
AIS_BBOX_SW_LAT=29.823
AIS_BBOX_SW_LON=-93.9586
AIS_BBOX_NE_LAT=29.866
AIS_BBOX_NE_LON=-93.930

# --- Workers (production stack only — docker-compose.prod.yml) ---
# API worker processes (gunicorn). Tune to the host's CPU.
WEB_CONCURRENCY=4
# Seconds between occupancy-derivation passes.
OCC_EVERY=60

# --- AI-assisted intake (OpenRouter + Dataverse worker) ---
# Berth requests are entered manually by an operator (phone / email / walk-in).
# OPTIONALLY, the dataverse worker (app/intake/dataverse_run.py) pulls requests
# from the Power Pages "Berth Request" table and normalizes each with a cheap LLM
# before recording it (still as a `requested` row an operator reconciles). Leave
# the keys blank to keep intake manual-only; set them to enable the worker.
#
# OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Cheapest Gemini Flash by default; any OpenRouter model id works.
INTAKE_LLM_MODEL=google/gemini-2.5-flash-lite
# Source tag for AI-parsed cards (must be phone|email|operator so operators can
# still edit/delete them).
INTAKE_LLM_SOURCE=email
#
# Dataverse Web API (outbound only — Azure AD app-registration / client creds).
DATAVERSE_URL=                       # e.g. https://yourorg.crm.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
# Entity set + key field of the Berth Request table (publisher prefix `popa`).
DATAVERSE_TABLE=popa_berthrequests
DATAVERSE_ID_FIELD=popa_berthrequestid
# Request Status choice column + the integer option values for New / Triaged.
# Read the exact integers from make.powerapps.com -> the choice column (each
# option shows its value). BOTH must be set or the worker refuses to start.
DATAVERSE_STATUS_FIELD=popa_requeststatus
DATAVERSE_STATUS_NEW=417440000
DATAVERSE_STATUS_TRIAGED=417440002
# Seconds between polls, and max rows pulled per poll.
DATAVERSE_POLL_SECONDS=300
DATAVERSE_BATCH_LIMIT=25
