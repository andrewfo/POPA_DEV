# Copy to .env and fill in. docker-compose and the app both read these.

# --- Database ---
# Local dev default matches docker-compose.yml below.
POSTGRES_USER=popa
POSTGRES_PASSWORD=popa
POSTGRES_DB=popa_wharf
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* vars above.
# DATABASE_URL=postgresql+psycopg://popa:popa@localhost:5432/popa_wharf

# --- Operator auth (HTTP Basic, whole app) ---
# Leave BOTH blank for local dev: auth is disabled and the app runs open. Set
# both to gate the whole app (map + reads + writes) behind one login — see the
# production stack (docker-compose.prod.yml / .env.prod.example). Basic auth must
# run behind TLS.
OPERATOR_USER=
OPERATOR_PASSWORD=

# --- AIS ingestion ---
# Get a free key at https://aisstream.io
AISSTREAM_API_KEY=

# Bounding box around the POPA public wharf on the Sabine-Neches waterway.
# Two corners: SW (lat,lon) and NE (lat,lon). Decimal degrees.
AIS_BBOX_SW_LAT=29.823
AIS_BBOX_SW_LON=-93.9586
AIS_BBOX_NE_LAT=29.866
AIS_BBOX_NE_LON=-93.930

# Berth requests are entered manually by an operator (phone / email / walk-in);
# there is no automated online-form feed to configure.
